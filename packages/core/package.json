{
  "name": "@click-to-source-3d/core",
  "version": "0.1.5",
  "description": "Core provenance engine for Click-to-Source 3D",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "default": "./dist/devtools.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@click-to-source-3d/shared": "0.1.5"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "vitest": "^4.1.11"
  }
}
