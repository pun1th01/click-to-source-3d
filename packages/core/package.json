{
  "name": "@click-to-source-3d/core",
  "version": "0.2.0",
  "description": "Find the source code behind any three.js object: resolving, picking, highlighting and measuring for building inspectors. Part of Click-to-Source 3D.",
  "keywords": [
    "threejs",
    "three.js",
    "react-three-fiber",
    "r3f",
    "webgl",
    "3d",
    "devtools",
    "inspector",
    "raycasting",
    "provenance",
    "click-to-source"
  ],
  "license": "MIT",
  "author": "Punith P (https://github.com/pun1th01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "bugs": {
    "url": "https://github.com/pun1th01/click-to-source-3d/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "default": "./dist/devtools.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@click-to-source-3d/shared": "0.2.0"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "vitest": "^4.1.11"
  }
}
