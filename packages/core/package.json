{
  "name": "@click-to-source-3d/core",
  "version": "0.1.0",
  "description": "Core provenance engine for Click-to-Source 3D",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@click-to-source-3d/shared": "0.1.0"
  },
  "peerDependencies": {
    "three": ">=0.170.0 <0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "vitest": "^4.1.11"
  }
}
