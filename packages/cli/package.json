{
  "name": "click-to-source-3d",
  "version": "0.1.6",
  "description": "One command, nothing else, to add Click-to-Source 3D to a three.js or React Three Fiber project: click any mesh to see the line of code that made it and edit its values live.",
  "keywords": [
    "threejs",
    "three.js",
    "react-three-fiber",
    "r3f",
    "webgl",
    "3d",
    "vite",
    "cli",
    "setup",
    "devtools",
    "inspector",
    "click-to-source"
  ],
  "license": "MIT",
  "author": "Punith P (https://github.com/pun1th01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "bugs": {
    "url": "https://github.com/pun1th01/click-to-source-3d/issues"
  },
  "type": "module",
  "bin": {
    "click-to-source-3d": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@click-to-source-3d/shared": "0.1.6",
    "magic-string": "^0.30.21"
  }
}
