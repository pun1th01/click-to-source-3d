{
  "name": "@click-to-source-3d/shared",
  "version": "0.1.4",
  "description": "Shared utilities and types for Click-to-Source 3D",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run --passWithNoTests"
  }
}
