{
  "name": "@click-to-source-3d/shared",
  "version": "0.2.0",
  "description": "Types and protocol constants shared by the Click-to-Source 3D packages. Internal.",
  "keywords": [
    "click-to-source",
    "threejs",
    "react-three-fiber"
  ],
  "license": "MIT",
  "author": "Punith P (https://github.com/pun1th01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "bugs": {
    "url": "https://github.com/pun1th01/click-to-source-3d/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run --passWithNoTests"
  }
}
