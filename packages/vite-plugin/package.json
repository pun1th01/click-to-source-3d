{
  "name": "@click-to-source-3d/vite-plugin",
  "version": "0.1.6",
  "description": "Click any mesh in a three.js or React Three Fiber scene to see the line of code that made it, the calls that led there, the helpers it used, and edit its values live. A Vite plugin with nothing to add to your code.",
  "keywords": [
    "threejs",
    "three.js",
    "react-three-fiber",
    "r3f",
    "webgl",
    "3d",
    "vite",
    "vite-plugin",
    "devtools",
    "inspector",
    "debugging",
    "developer-tools",
    "click-to-source",
    "hot-reload",
    "mcp"
  ],
  "license": "MIT",
  "author": "Punith P (https://github.com/pun1th01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "bugs": {
    "url": "https://github.com/pun1th01/click-to-source-3d/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b && tsc -p tsconfig.client.json && vite build -c client.vite.config.ts",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run test",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@click-to-source-3d/shared": "0.1.6",
    "launch-editor": "^2.14.2",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "three": ">=0.150.0",
    "vite": ">=5.0.0 <9.0.0"
  },
  "devDependencies": {
    "@click-to-source-3d/core": "0.1.6",
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
