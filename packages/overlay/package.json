{
  "name": "@click-to-source/overlay",
  "version": "0.1.0",
  "description": "Interactive inspection overlay for Click-to-Source 3D",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b --force",
    "prepublishOnly": "npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@click-to-source/core": "0.1.0",
    "@click-to-source/shared": "0.1.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.170.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.170.0",
    "vitest": "^2.1.8"
  }
}
