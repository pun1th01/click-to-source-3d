{
  "name": "@click-to-source-3d/mcp",
  "version": "0.1.6",
  "description": "MCP server that lets AI coding assistants like Claude Code see a running three.js or React Three Fiber scene, read the meshes you point at, and edit their values in source.",
  "keywords": [
    "threejs",
    "three.js",
    "react-three-fiber",
    "r3f",
    "webgl",
    "3d",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-tools",
    "cursor",
    "devtools",
    "click-to-source"
  ],
  "license": "MIT",
  "author": "Punith P (https://github.com/pun1th01)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pun1th01/click-to-source-3d.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/pun1th01/click-to-source-3d#readme",
  "bugs": {
    "url": "https://github.com/pun1th01/click-to-source-3d/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "click-to-source-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b",
    "prepack": "npm run clean && tsc -b",
    "prepublishOnly": "npm run test",
    "pretest": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@click-to-source-3d/shared": "0.1.6",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^4.1.11"
  }
}
